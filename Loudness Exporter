import librosa
import numpy as np

input_file = "File name.mp3"
output_file = "File name - Loudness.txt"

def process_audio():
    try:
        y, sr = librosa.load(input_file, sr=None)

        data_per_second = 30 #If you want to lower file size, decrease this number, if you want higher quality, increase it. I recommend not going below 10.
        hop_length = int(sr * (1/data_per_second))

        rms = librosa.feature.rms(y=y, frame_length=hop_length*2, hop_length=hop_length)[0]

        max_val = np.max(rms) if np.max(rms) > 0 else 1
        normalized_rms = (rms / max_val) * 100

        with open(output_file, 'w') as f:
            for value in normalized_rms:
                f.write(f"{int(round(value))}\n")

        print(f"Created {output_file} with {len(normalized_rms)} entries.")

    except Exception as e:
        print(f"Error: {e}")

process_audio()
